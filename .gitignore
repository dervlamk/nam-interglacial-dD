*.mat
*.asv
slprj/

# Proxy spreadsheets live on OneDrive ($PROXY_DATA_DIR) and are never copied into the repo.
# Belt and braces in case one gets dragged in.
*.xlsx
*.xls

# Local path overrides (copy config/paths.env.example to fill this in)
config/paths.env
