# Base paths for this project's data pipeline.
#
# This project runs on TWO machines and NEITHER has all the data. That is deliberate:
#
#   NCAR HPC (Casper/Derecho)  -> iCESM1.2 model output on /glade. Model side only.
#   Laptop                     -> proxy + observational data on OneDrive, the MATLAB
#                                 dDwax/dDp/%JAS pipeline, and the proxy figure notebooks.
#
# Nothing is copied between them. Only small derived products cross, and they cross
# through this repo (see data/processed/) rather than by data transfer.
#
# Set the block for the machine you are on and leave the other block unset. An unset
# variable is not an error — it means that stage does not run here.
#
# Copy this file to config/paths.env and edit the values for your own
# environment (config/paths.env is gitignored, so your copy stays local).
#
# - Shell scripts (scripts/nco/*.sh) source this file directly.
# - NCL scripts (scripts/ncl/*.ncl) read these via getenv(), so `source` this
#   file in your shell before running ncl, e.g.:
#     source config/paths.env && ncl scripts/ncl/make_2d_atm_vars_nc.ncl
# - Notebooks read WORK_DATA_DIR via os.environ, with the current hardcoded
#   value kept as the fallback default if it's unset.

# Base scratch directory for intermediate netCDFs written by the NCL/NCO
# preprocessing scripts (each script appends /PI or /LIG as needed)
export SCRATCH_DIR=/glade/derecho/scratch/$USER

# Top-level working directory the notebooks read intermediate netCDFs,
# obs/proxy comparison data, and figure output from
export WORK_DATA_DIR=/glade/work/$USER

# Where LGM_analyses.ipynb (and any other HPC-side notebook) writes figures. This is a
# separate variable from FIG_OUTPUT_DIR below, not the same variable reused with a different
# per-machine value: HPC has no path to OneDrive, so figures land on glade instead and have
# to be synced to the laptop-side FIG_OUTPUT_DIR by hand (rsync/scp) when you want them there.
# Defaults to a figures/ subdir next to the PI/, LGM/, obs_data/ dirs under WORK_DATA_DIR if
# unset.
export HPC_FIG_OUTPUT_DIR=/glade/work/$USER/figures

# Raw iCESM1.2 archive/timeseries locations (read-only, on shared campaign storage)
export PI_CLIMO_DIR=/glade/campaign/univ/uazn0018/jiangzhu/archive/b.e12.B1850C5.f19_g16.iPI.01/climo
# Moved 2026-08-10: this case used to live under .../cesm/development/palwg/..., which no longer
# exists. It is now on community storage alongside the LGM/PI deglacial-slice cases below. The
# run is 501 years (000101-050112); per-variable monthly tseries in 50-year chunks.
export LIG_CASE_DIR=/glade/campaign/cesm/community/palwg/LastInterglacial/iCESM1.2/b.e12.B1850C5.f19_g16.iLIG127k.001

# NOTE: there is deliberately no variable here for the paleo-calendar-adjusted LIG output that
# notebooks/LIG127k_analyses_PALEOCALADJUSTED.ipynb reads. Those files were staged into this
# repo's own data/raw/ on 2026-08-10 and the notebook resolves them from $REPO_ROOT, so
# replicating it needs a clone plus data/raw/ and nothing else -- no PaleoCalAdjust install.
# They were produced by PaleoCalAdjust v1.1 (cal_adjust.f90) under $WORK_DATA_DIR/PaleoCalAdjust/;
# see DATA_MANIFEST.md §3 and the notebook's header cell for the full provenance.

# One-off: scripts/ncl/maketimeseries.ncl reads LIG ocean timeseries from a
# collaborator's scratch space rather than the campaign archive above.
export LIG_TIMESERIES_JS_DIR=/glade/scratch/jschnaubelt/timeseries/b.e12.B1850C5.f19_g16.iLIG127k.001/ocn/proc/tseries/month_1

# The LGM (21 ka) case, b.e12.B1850C5.f19_g16.i21ka.03, is the sibling of the PI run above.
# Found 2026-08-09 on campaign storage (read-only). Per-variable monthly tseries live under
# atm/proc/tseries/monthly/<VAR>/, years 0001-0900 in one file per variable -- not a climo dir
# like PI_CLIMO_DIR above, must be subset per use (see scripts/nco/subset_tseries.sh).
export LGM_CASE_DIR=/glade/campaign/cesm/community/palwg/iCESM1.2-DeglacialSlice/b.e12.B1850C5.f19_g16.i21ka.03

# PI per-year monthly tseries, sibling of LGM_CASE_DIR above, same campaign tree. Distinct from
# PI_CLIMO_DIR above: that path is a pre-collapsed climatology with no per-year data and is
# depended on as-is by get_climo_vars.sh / integrate_isotopes.sh -- do not repoint it here.
export PI_CASE_DIR=/glade/campaign/cesm/community/palwg/iCESM1.2-DeglacialSlice/b.e12.B1850C5.f19_g16.iPI.01

# Root of this repo's own clone. Read by scripts/nco/subset_tseries.sh and
# scripts/ncl/pressureRegrid_tseries.ncl, which write/read this repo's own data/raw/tseries/ and
# data/interim/tseries/ trees rather than WORK_DATA_DIR -- see data/README.md. Unlike every other
# var in this file, the correct value here depends on where this clone lives: if you move or
# re-clone the repo, update this by hand, or the two scripts will silently write to the old path.
export REPO_ROOT=/glade/work/$USER/nam-interglacial-dD


# =============================================================================
# LAPTOP ONLY — proxy + observational data.
# Leave these unset on Casper: none of it is staged to glade, on purpose.
# =============================================================================

# Proxy records (leaf-wax dD, Bacon age models, LR04) and observational data (OIPC,
# IMERG, ETOPO5). Consumed by scripts/matlab/ and the proxy figure notebooks.
#
# DEFAULT, for anyone reproducing these results: download the datasets listed in
# DATA_MANIFEST.md into the repo's own data/ tree (see data/README.md) and use:
export PROXY_DATA_DIR=./data/raw
export OBS_DATA_DIR=./data/external
#
# The author's copies predate that layout and live on OneDrive; they are not being
# moved. If yours are somewhere else too, just point these at it instead — nothing
# downstream knows or cares which you chose:
#export PROXY_DATA_DIR=/Users/dervlamk/OneDrive/data/proxies
#export OBS_DATA_DIR=/Users/dervlamk/OneDrive/data/obs

# Where figures are written. Kept OUTSIDE the repo, in OneDrive, so working figures are
# backed up — they are not in git. tools/sync_manuscript_figs.sh promotes the manuscript set
# from here into its for_manuscript/ subdirectory.
#
# REQUIRED: the notebooks refuse to guess if this is unset. That is deliberate — the old
# fallback silently created a second outputs directory that the sync script never read, and
# figures diverged between the two without warning.
export FIG_OUTPUT_DIR=/Users/dervlamk/OneDrive/projects/nam-dD-lig/figures
